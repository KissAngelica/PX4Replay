{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PX4 飞行回放",
  "version": "0.1.0",
  "identifier": "dev.px4.flight-replay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PX4 飞行回放",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "macOS": {
      "signingIdentity": "-"
    },
    "resources": {
      "../tools/ulog_parser/parse_ulog.py": "tools/ulog_parser/parse_ulog.py",
      "../tools/ulog_parser/requirements.txt": "tools/ulog_parser/requirements.txt"
    }
  }
}
